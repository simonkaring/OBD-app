<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>VoltLink</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>VoltLink requires Bluetooth access to connect to your Vgate iCar Pro 2S OBD-II adapter for real-time car diagnostics and EV telemetry.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>VoltLink requires Bluetooth to communicate with your OBD-II adapter.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>VoltLink uses GPS location to track your trip routes and map vehicle energy efficiency.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>VoltLink requires background location access to log continuous trip data when the app is minimized.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>
</dict>
</plist>
